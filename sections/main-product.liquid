{{ 'section-main-product-custom.css' | asset_url | stylesheet_tag }}

<section class="lp-product">
  <div class="lp-grid">
    <div class="lp-media">
      {% if product.featured_image %}
        <img
          width="600"
          height="600"
          srcset=" {{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 900 }} 900w "
          sizes="(min-width: 990px) 520px, 100vw"
          src="{{ product.featured_image | image_url: width: 600 }}"
          alt="{{ product.featured_image.alt | escape }}"
        >
      {% endif %}
    </div>

    <div class="lp-main">
      <h1 class="lp-title">{{ product.title }}</h1>

      <div class="lp-variant-tiles" role="list" aria-label="Select pack size">
        {% for v in product.variants %}
          <button
            type="button"
            class="lp-variant-tile{% if v.id == product.selected_or_first_available_variant.id %} is-active{% endif %}"
            data-variant-id="{{ v.id }}"
            data-variant-title="{{ v.title | escape }}"
            data-variant-price="{{ v.price }}"
            data-variant-available="{{ v.available }}"
          >
            <span class="lp-variant-name">{{ v.title }}</span>
            <span class="lp-variant-price">{{ v.price | money }}</span>
          </button>
        {% endfor %}
      </div>

      {% if product.metafields.custom.short_description != blank %}
        <div class="lp-shortdesc">
          {{ product.metafields.custom.short_description | metafield_text }}
        </div>
      {% endif %}
    </div>

    <aside class="lp-aside">
      <div class="lp-price-row">
        <div class="lp-price" data-price>
          {{ product.selected_or_first_available_variant.price | money }}
        </div>

        {% assign active_sku = product.selected_or_first_available_variant.sku %}
        {% if active_sku != blank %}
          <span class="lp-sku-pill" data-sku>SKU {{ active_sku }}</span>
        {% endif %}
      </div>
      <div class="lp-stock" data-stock>
        {% if product.selected_or_first_available_variant.available %}In Stock{% else %}Out of Stock{% endif %}
      </div>

      <form method="post" action="/cart/add" id="lp-atc-form">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-input>
        <div class="lp-qty">
          <button type="button" class="lp-qty-btn" data-qty-minus aria-label="Decrease quantity">−</button>
          <input type="number" name="quantity" value="1" min="1" inputmode="numeric">
          <button type="button" class="lp-qty-btn" data-qty-plus aria-label="Increase quantity">+</button>
        </div>
        <button
          type="submit"
          class="lp-btn lp-btn--primary"
          data-atc
          {% unless product.selected_or_first_available_variant.available %}
            disabled
          {% endunless %}
        >
          ADD TO CART
        </button>
      </form>

      <div class="lp-list">
        <button type="button" class="lp-btn lp-btn--ghost"><span>＋</span> ADD TO LIST</button>
        <a href="#" class="lp-fav-link">Show my favourites</a>
      </div>
    </aside>
  </div>

  <div class="lp-accordions">
    {% if product.description != blank %}
      <details open>
        <summary>Product Description</summary>
        <div class="lp-accordion-body rte">
          {{ product.description }}
        </div>
      </details>
    {% endif %}

    {%- assign spec_fields = product.metafields.specification -%}

    {%- if spec_fields != blank -%}
      <details open>
        <summary>Specification</summary>
        <div class="lp-accordion-body">
          <table class="lp-spec-table">
            <tbody>
              {%- for mf in spec_fields -%}
                {%- assign label = mf.first | replace: '_', ' ' | capitalize -%}
                {%- assign value = mf.last | metafield_text -%}
                {%- if value != blank -%}
                  <tr>
                    <td>{{ label }}</td>
                    <td>{{ value }}</td>
                  </tr>
                {%- endif -%}
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      </details>
    {%- endif -%}

    {%- assign data_sheets = product.metafields.custom.data_sheet.value -%}

    {%- if data_sheets != blank -%}
      <details>
        <summary>
          Product Data Sheets
          <span class="lp-badge">
            {%- assign count = 0 -%}
            {%- for sheet in data_sheets -%}
              {%- assign count = count | plus: 1 -%}
            {%- endfor -%}
            {{ count }}
          </span>
        </summary>
        <div class="lp-accordion-body">
          <ul class="lp-datasheet-list">
            {%- for sheet in data_sheets -%}
              {%- if sheet.url != blank -%}
                <li>
                  <a href="{{ sheet.url }}" target="_blank" rel="noopener">
                    {{ sheet.name | default: 'Data Sheet ' | append: forloop.index }}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </details>
    {%- endif -%}
  </div>

  <!-- Sticky mobile CTA -->
  <div class="lp-sticky-cta" id="lp-sticky-cta">
    <div class="lp-sticky-price" data-sticky-price>
      {{ product.selected_or_first_available_variant.price | money }}
    </div>
    <button type="button" class="lp-sticky-btn" data-sticky-atc>ADD TO CART</button>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const product = {{ product | json }};
    const formatMoney = (cents) => {
      if (window?.Shopify?.formatMoney) return Shopify.formatMoney(cents, "{{ shop.money_format }}");
      return (cents/100).toLocaleString(undefined,{style:'currency',currency:'{{ shop.currency }}'});
    };

    const tiles   = document.querySelectorAll('.lp-variant-tile');
    const priceEl = document.querySelector('[data-price]');
    const stockEl = document.querySelector('[data-stock]');
    const skuEl   = document.querySelector('[data-sku]');
    const idInput = document.querySelector('[data-variant-input]');
    const atcBtn  = document.querySelector('[data-atc]');

    function syncSticky() {
      const stickyBar   = document.getElementById('lp-sticky-cta');
      if (!stickyBar) return;
      const stickyPrice = document.querySelector('[data-sticky-price]');
      const stickyAtc   = document.querySelector('[data-sticky-atc]');
      if (stickyPrice && priceEl) stickyPrice.textContent = priceEl.textContent;
      if (stickyAtc && atcBtn)    stickyAtc.disabled = atcBtn.disabled;
    }

    function renderVariant(variant) {
      tiles.forEach(t => t.classList.toggle('is-active', t.dataset.variantId == variant.id));

      if (idInput)  idInput.value = variant.id;
      if (priceEl)  priceEl.textContent = formatMoney(variant.price);
      if (stockEl)  stockEl.textContent = variant.available ? 'In Stock' : 'Out of Stock';
      if (skuEl)    skuEl.textContent = variant.sku ? `SKU ${variant.sku}` : '';
      if (atcBtn)   atcBtn.disabled = !variant.available;

      const url = new URL(window.location.href);
      url.searchParams.set('variant', variant.id);
      window.history.replaceState({}, '', url.toString());

      syncSticky();
    }

    function selectVariant(id) {
      const variant = product.variants.find(v => v.id == id);
      if (variant) renderVariant(variant);
    }

    tiles.forEach(btn => btn.addEventListener('click', () => selectVariant(btn.dataset.variantId)));

    const stickyAtc = document.querySelector('[data-sticky-atc]');
    if (stickyAtc) {
      stickyAtc.addEventListener('click', () => {
        document.getElementById('lp-atc-form')?.requestSubmit();
      });
    }

    (function init() {
      const urlId = new URL(window.location.href).searchParams.get('variant');
      if (urlId) {
        const v = product.variants.find(v => v.id == urlId);
        if (v) return renderVariant(v);
      }
      syncSticky();
    })();

    if (priceEl) {
      const mo = new MutationObserver(syncSticky);
      mo.observe(priceEl, { childList: true, subtree: true, characterData: true });
    }

    window.addEventListener('popstate', () => {
      const id = new URL(window.location.href).searchParams.get('variant');
      if (id) selectVariant(id);
    });

    document.addEventListener('shopify:section:load', syncSticky);
    document.addEventListener('shopify:section:select', syncSticky);
  });
</script>
<style>
  .lp-datasheet-list li::before {
    content: '';
    width: 18px;
    height: 18px;
    background: url('{{ "pdf-icon.svg" | asset_url }}') no-repeat center / contain;
    flex: 0 0 18px;
  }
</style>
